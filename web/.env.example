# Core API base URL (no trailing slash). Local dev default is http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Local/dev-only: swap the free 2D/3D viseme avatar for a live HeyGen LiveAvatar video
# stream (see core/app/liveavatar.py and core/.env.example). Costs credits per minute —
# never enable this for the deployed course.
VITE_LIVE_AVATAR=0
