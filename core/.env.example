# Copy to core/.env. Empty provider keys simply disable that provider.
#
# THE ONLY KEY THIS PROJECT NEEDS IS LIVEAVATAR_API_KEY (HeyGen), and only if you want
# the streaming avatar. Brain, speech-in and speech-out all run locally with no account:
#   brain   Qwen3-8B via Ollama          (LOCAL_LLM_*)
#   ears    faster-whisper               (LOCAL_STT_*)
#   voice   Piper, ar/en/fr              (python -m app.cli voices)
# The cloud LLM keys below are optional overflow for when the local server is down or
# saturated. Leaving every one of them empty is a supported, fully working install.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-another-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# Google Sign-In — OPTIONAL, and the one thing that turns on saved chat history. With it
# empty the tutor still answers, but history stays browser-local as before (no account, no
# server-side conversation text). This is a client ID, not a secret: it ships inside the web
# bundle by design, and ID tokens are verified against Google's public JWKS, so there is no
# client secret to hold. Create one at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:5173 (plus your deployed origin)
GOOGLE_CLIENT_ID=

# Local model server — the preferred lane: no key, no quota, no daily cap. Any
# OpenAI-compatible server works (Ollama, llama.cpp --server, vLLM). Pull the model first:
#   ollama pull qwen3:8b
#
# SPEED. Two things dominate how long an answer takes, and neither is this project's code:
#   1. Model load. Ollama unloads an idle model, and reloading 8B costs seconds on every
#      question after a pause. Fix it on the Ollama side, once:
#        setx OLLAMA_KEEP_ALIVE -1      (Windows; `export` on mac/Linux, then restart ollama)
#      The core also fires a warm-up request at startup so the first student never waits.
#   2. Tokens per second. On a CPU, qwen3:8b runs at a few tokens a second — a paragraph
#      takes tens of seconds and no amount of tuning changes that. With a GPU it is
#      instant. Without one, LOCAL_LLM_MODEL=qwen3:4b is roughly twice as fast and still
#      handles all three languages; qwen3:1.7b is faster again and noticeably weaker.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_CONCURRENCY=2

# OPTIONAL cloud LLM overflow (free tiers) — only reached when the local server is down or
# saturated. Leave them all empty to run key-free; see providers.yaml for limits.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Live STT — faster-whisper, the same model the ingest pipeline uses. No key, no quota,
# nothing leaves the machine, and far better Egyptian Arabic than the browser recogniser.
# Arabic questions are primed with a line of Cairo speech so the decoder stays in dialect
# instead of "correcting" إزاي to كيف. `small` int8 is the CPU-sane default (~1-2s for a
# short question on 4 cores); with a GPU use large-v3-turbo + cuda for near-instant.
# If GROQ_API_KEY happens to be set it is preferred, but it is in no way required.
LOCAL_STT_ENABLED=true
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE=int8
LOCAL_STT_CONCURRENCY=1

# LiveAvatar (HeyGen real-time streaming) — LOCAL/DEV-ONLY. Bills per minute from HeyGen's
# cloud, so it cannot be the free, no-quota default this project promises at 400 students —
# see core/app/liveavatar.py. Pair with web/.env.local VITE_LIVE_AVATAR=1.
# LIVEAVATAR_SANDBOX=true (or running out of credits, which auto-falls back) swaps in
# HeyGen's fixed sandbox avatar and caps sessions at ~60s, for $0.
LIVEAVATAR_ENABLED=false
LIVEAVATAR_SANDBOX=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Leave blank. This is a HeyGen-side voice id, and sandbox ignores it entirely — the
# sandbox avatar speaks in its own voice, in whatever language the answer is in. Setting it
# only matters on the billed path, which needs a voice bound to your HeyGen key.
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_TTS_SPEED=1.00
LIVEAVATAR_TTS_STABILITY=0.80
LIVEAVATAR_TTS_STYLE=0.25
# A HeyGen-side model name they accept in this field — it is not an ElevenLabs account and
# no ElevenLabs key is ever read by this project. Leave it as is.
LIVEAVATAR_TTS_MODEL=eleven_multilingual_v2

# Retrieval gate thresholds (dense cosine, e5-base). Calibrate with eval/run_eval.py
GATE_THRESHOLD_AR=0.77
GATE_THRESHOLD_EN=0.80
GATE_THRESHOLD_FR=0.78
