# Copy to core/.env. Empty provider keys simply disable that provider.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-another-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# Local model server — the preferred lane: no key, no quota, no daily cap. Any
# OpenAI-compatible server works (Ollama, llama.cpp --server, vLLM). Pull the model first:
#   ollama pull qwen3:8b
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_CONCURRENCY=2

# LLM providers (free tiers) — only reached when the local server is down or saturated.
# One key each, see providers.yaml for limits
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# LiveAvatar (HeyGen real-time streaming) — LOCAL/DEV-ONLY. Bills per minute from HeyGen's
# cloud, so it cannot be the free, no-quota default this project promises at 400 students —
# see core/app/liveavatar.py. Pair with web/.env.local VITE_LIVE_AVATAR=1.
# LIVEAVATAR_SANDBOX=true (or running out of credits, which auto-falls back) swaps in
# HeyGen's fixed sandbox avatar and caps sessions at ~60s, for $0.
LIVEAVATAR_ENABLED=false
LIVEAVATAR_SANDBOX=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Optional: a LiveAvatar-bound voice (POST /v1/voices/third_party) — GET /v1/voices lists
# what's actually bound to your API key. Leave blank to use the avatar's own default voice.
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_TTS_SPEED=1.00
LIVEAVATAR_TTS_STABILITY=0.80
LIVEAVATAR_TTS_STYLE=0.25
LIVEAVATAR_TTS_MODEL=eleven_multilingual_v2

# Retrieval gate thresholds (dense cosine, e5-base). Calibrate with eval/run_eval.py
GATE_THRESHOLD_AR=0.77
GATE_THRESHOLD_EN=0.80
GATE_THRESHOLD_FR=0.78
