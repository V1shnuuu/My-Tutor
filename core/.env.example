# Copy to core/.env. Empty provider keys simply disable that provider.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-another-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.pages.dev

# LLM providers (free tiers) — one key each, see providers.yaml for limits
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Retrieval gate thresholds (dense cosine, e5-base). Calibrate with eval/run_eval.py
GATE_THRESHOLD_AR=0.78
GATE_THRESHOLD_EN=0.80
GATE_THRESHOLD_FR=0.80
